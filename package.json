{
  "name": "reprex-generator-for-r",
  "displayName": "Reprex Generator (for R)",
  "description": "Creates reproducible examples from active file or selected lines using {reprex}",
  "version": "0.4.0",
  "publisher": "jemus42",
  "author": {
    "name": "Lukas Burk",
    "url": "https://lukasburk.de"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "homepage": "https://github.com/jemus42/reprex-generator-for-r",
  "bugs": {
    "url": "https://github.com/jemus42/reprex-generator-for-r/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jemus42/reprex-generator-for-r.git"
  },
  "keywords": [
    "r",
    "reprex",
    "reproducible",
    "example",
    "statistics",
    "data-science",
    "markdown"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e3a5f",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Reprex",
      "properties": {
        "reprex.venue": {
          "type": "string",
          "default": "gh",
          "enum": [
            "gh",
            "slack",
            "r",
            "html",
            "so",
            "ds"
          ],
          "enumDescriptions": [
            "GitHub-Flavored Markdown (default)",
            "Slack message",
            "Runnable R script with commented output",
            "HTML fragment",
            "Stack Overflow (alias for gh)",
            "Discourse (alias for gh)"
          ],
          "description": "Default output format for reprex. Use the \"choose venue\" commands to override per run."
        },
        "reprex.rscriptPath": {
          "type": "string",
          "default": "Rscript",
          "markdownDescription": "Path to the `Rscript` executable. Defaults to `Rscript` from `PATH`."
        },
        "reprex.copyToClipboard": {
          "type": "boolean",
          "default": true,
          "description": "Copy the rendered reprex to the clipboard."
        }
      }
    },
    "commands": [
      {
        "command": "reprex-generator-for-r.reprexAddin",
        "title": "Start Addin",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexFile",
        "title": "Active File",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexSelection",
        "title": "Selected Code",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexFileVenue",
        "title": "Active File (Choose Venue)...",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexSelectionVenue",
        "title": "Selected Code (Choose Venue)...",
        "category": "Reprex"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "reprex-generator-for-r.reprexSelection",
          "when": "editorLangId == r && editorHasSelection",
          "group": "reprex@1"
        },
        {
          "command": "reprex-generator-for-r.reprexSelectionVenue",
          "when": "editorLangId == r && editorHasSelection",
          "group": "reprex@2"
        },
        {
          "command": "reprex-generator-for-r.reprexFile",
          "when": "editorLangId == r && !editorHasSelection",
          "group": "reprex@1"
        },
        {
          "command": "reprex-generator-for-r.reprexFileVenue",
          "when": "editorLangId == r && !editorHasSelection",
          "group": "reprex@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.102.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.32.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Reprex runs Rscript, which sources .Rprofile files from the workspace."
    },
    "virtualWorkspaces": false
  }
}
