{
  "name": "reprex-generator-for-r",
  "displayName": "Reprex Generator (for R)",
  "description": "Creates reproducible examples from active file or selected lines using {reprex}",
  "version": "0.5.1",
  "publisher": "jemus42",
  "author": {
    "name": "Lukas Burk",
    "url": "https://lukasburk.de"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "homepage": "https://github.com/jemus42/reprex-generator-for-r",
  "bugs": {
    "url": "https://github.com/jemus42/reprex-generator-for-r/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jemus42/reprex-generator-for-r.git"
  },
  "keywords": [
    "r",
    "reprex",
    "reproducible",
    "example",
    "statistics",
    "data-science",
    "markdown"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e3a5f",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Reprex",
      "properties": {
        "reprex.venue": {
          "type": "string",
          "default": "gh",
          "enum": [
            "gh",
            "slack",
            "r",
            "html",
            "so",
            "ds"
          ],
          "enumDescriptions": [
            "GitHub-Flavored Markdown (default)",
            "Slack message",
            "Runnable R script with commented output",
            "HTML fragment",
            "Stack Overflow (alias for gh)",
            "Discourse (alias for gh)"
          ],
          "description": "Default output format for reprex. Use the \"choose venue\" commands to override per run."
        },
        "reprex.rscriptPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `Rscript` executable. When empty, Positron's selected R interpreter is used, falling back to `Rscript` from `PATH`.",
          "scope": "machine"
        },
        "reprex.copyToClipboard": {
          "type": "boolean",
          "default": true,
          "description": "Copy the rendered reprex to the clipboard."
        },
        "reprex.outputLocation": {
          "type": "string",
          "default": "user",
          "enum": [
            "user",
            "project",
            "custom"
          ],
          "enumDescriptions": [
            "User-wide cache directory (XDG cache dir on Linux, ~/Library/Caches on macOS, %LOCALAPPDATA% on Windows)",
            "`.reprex/` in the workspace folder, with a self-ignoring .gitignore",
            "The directory in `reprex.outputPath`"
          ],
          "description": "Where figures produced by a reprex are kept. Each run gets its own subdirectory."
        },
        "reprex.outputPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Directory used when `#reprex.outputLocation#` is `custom`. Supports `~` and `${workspaceFolder}`; relative paths are resolved against the workspace folder.",
          "scope": "machine"
        },
        "reprex.uploadPlots": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let `{reprex}` upload plots anonymously to imgur and link them in the output (its default for every venue except `r`). When disabled, plots stay local and the output refers to them by file path."
        },
        "reprex.sessionInfo": {
          "type": "string",
          "enum": [
            "default",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Use reprex's default (and any `reprex.*` option set in `.Rprofile`)",
            "Always on",
            "Always off"
          ],
          "default": "default",
          "markdownDescription": "Append `sessionInfo()` to the reprex."
        },
        "reprex.advertise": {
          "type": "string",
          "enum": [
            "default",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Use reprex's default (and any `reprex.*` option set in `.Rprofile`)",
            "Always on",
            "Always off"
          ],
          "default": "default",
          "markdownDescription": "Add the \"Created on … with reprex\" footer."
        },
        "reprex.style": {
          "type": "string",
          "enum": [
            "default",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Use reprex's default (and any `reprex.*` option set in `.Rprofile`)",
            "Always on",
            "Always off"
          ],
          "default": "default",
          "markdownDescription": "Style the code with `{styler}` (must be installed)."
        },
        "reprex.comment": {
          "type": "string",
          "default": "",
          "markdownDescription": "Prefix for output lines. Empty uses reprex's default (`#>`)."
        },
        "reprex.timeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 0,
          "markdownDescription": "Stop a reprex that runs longer than this many seconds. `0` disables the limit."
        },
        "reprex.keepFiguresDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "markdownDescription": "Delete saved figure runs older than this many days from the output location. `0` keeps them forever. Only directories created by this extension are removed."
        }
      }
    },
    "commands": [
      {
        "command": "reprex-generator-for-r.reprexAddin",
        "title": "Start Addin",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexFile",
        "title": "Active File",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexSelection",
        "title": "Selected Code",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexFileVenue",
        "title": "Active File (Choose Venue)...",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexSelectionVenue",
        "title": "Selected Code (Choose Venue)...",
        "category": "Reprex"
      },
      {
        "command": "reprex-generator-for-r.reprexClipboard",
        "title": "Clipboard",
        "category": "Reprex"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "reprex-generator-for-r.reprexSelection",
          "when": "editorLangId == r && editorHasSelection",
          "group": "reprex@1"
        },
        {
          "command": "reprex-generator-for-r.reprexSelectionVenue",
          "when": "editorLangId == r && editorHasSelection",
          "group": "reprex@2"
        },
        {
          "command": "reprex-generator-for-r.reprexFile",
          "when": "editorLangId == r && !editorHasSelection",
          "group": "reprex@1"
        },
        {
          "command": "reprex-generator-for-r.reprexFileVenue",
          "when": "editorLangId == r && !editorHasSelection",
          "group": "reprex@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "tsc --noEmit && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@posit-dev/positron": "^0.2.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.102.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "ovsx": "^1.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Reprex runs Rscript, which sources .Rprofile files from the workspace."
    },
    "virtualWorkspaces": false
  }
}
