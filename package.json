{
  "name": "reprex-generator-for-r",
  "displayName": "Reprex Generator (for R)",
  "description": "Creates reproducible examples from active file or selected lines using {reprex}",
  "version": "0.0.13",
  "publisher": "jemus42",
  "author": {
    "name": "Lukas Burk",
    "url": "https://lukasburk.de"
  },
  "license": "MIT",
  "homepage": "https://codeberg.org/lksbrk/reprex-generator-for-r",
  "bugs": {
    "url": "https://codeberg.org/lksbrk/reprex-generator-for-r/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/lksbrk/reprex-generator-for-r.git"
  },
  "keywords": [
    "r",
    "reprex",
    "reproducible",
    "example",
    "statistics",
    "data-science",
    "markdown"
  ],
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science"
  ],
  "icon": "icon.svg",
  "galleryBanner": {
    "color": "#1e3a5f",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reprex-generator-for-r.reprexAddin",
        "title": "Reprex: Start Addin"
      },
      {
        "command": "reprex-generator-for-r.reprexFile",
        "title": "Reprex: Active File"
      },
      {
        "command": "reprex-generator-for-r.reprexSelection",
        "title": "Reprex: Selected Code"
      },
      {
        "command": "reprex-generator-for-r.reprexClipboard",
        "title": "Reprex: From Clipboard"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.102.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "ts-loader": "^9.5.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
